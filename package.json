{
  "private": true,
  "sideEffects": false,
  "scripts": {
    "build": "cross-env NODE_ENV=production npm run build:css && remix build",
    "build:css": "tailwindcss -m -i ./styles/app.css -o app/styles/app.css",
    "dev": "concurrently \"npm run dev:css\" \"remix dev\"",
    "dev:remix": "cross-env NODE_ENV=development PORT=4200 remix dev",
    "dev:css": "tailwindcss -w -i ./styles/app.css -o app/styles/app.css",
    "start": "cross-env NODE_ENV=production",
    "typecheck": "tsc",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "@reduxjs/toolkit": "^1.9.5",
    "@remix-run/css-bundle": "^1.14.0",
    "@remix-run/node": "^1.14.0",
    "@remix-run/react": "^1.14.0",
    "@remix-run/vercel": "^1.14.0",
    "axios": "^1.4.0",
    "bcryptjs": "^3.0.3",
    "classnames": "^2.3.2",
    "cloudinary": "^2.10.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.10",
    "isbot": "^3.6.8",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-redux": "^8.1.1",
    "resend": "^6.9.1",
    "sonner": "^2.0.7",
    "styled-components": "^6.0.8",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^1.14.0",
    "@remix-run/eslint-config": "^1.14.0",
    "@remix-run/serve": "^1.14.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^18.0.35",
    "@types/react-dom": "^18.0.11",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "eslint": "^8.38.0",
    "postcss": "^8.4.26",
    "prisma": "^6.17.1",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
