generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model module {
  id           Int                 @id(map: "pk_module") @default(autoincrement())
  key          String              @db.VarChar(100)
  name         String              @db.VarChar(100)
  icon         String              @db.VarChar(100)
  order        Int
  is_active    Boolean
  nav_zone     nav_zone_module
  nav_audience nav_audience_module
  permission   permission[]
}

model pet {
  id                        Int                   @id @default(autoincrement())
  name                      String                @db.VarChar(100)
  gender                    gender_pet
  pet_species_id            Int
  birthdate                 DateTime              @db.Date
  size                      String                @db.VarChar(50)
  color                     String                @db.VarChar(50)
  vaccinated                Boolean               @default(false)
  sterilized                Boolean               @default(false)
  description               String?
  race                      String?               @db.VarChar(100)
  creation_date             DateTime              @db.Timestamp(6)
  creator_id                Int
  update_date               DateTime              @db.Timestamp(6)
  updater_id                Int
  status                    status_pet            @default(Disponible)
  adoptionApplication       adoptionApplication[]
  user_pet_creator_idTouser user                  @relation("pet_creator_idTouser", fields: [creator_id], references: [id], onUpdate: Restrict, map: "fk_creator_pet")
  petSpecies                petSpecies            @relation(fields: [pet_species_id], references: [id], onUpdate: Restrict, map: "fk_species_pet")
  user_pet_updater_idTouser user                  @relation("pet_updater_idTouser", fields: [updater_id], references: [id], onUpdate: Restrict, map: "fk_updater_pet")
  pet_images                pet_images[]
  savedPet                  savedPet[]

  @@index([name])
}

model petSpecies {
  id                               Int      @id(map: "petcategory_pkey") @default(autoincrement())
  name                             String   @db.VarChar(100)
  active                           Boolean  @default(true)
  creation_date                    DateTime @default(now()) @db.Timestamp(6)
  creator_id                       Int
  update_date                      DateTime @default(now()) @db.Timestamp(6)
  updater_id                       Int
  pet                              pet[]
  user_petSpecies_creator_idTouser user     @relation("petSpecies_creator_idTouser", fields: [creator_id], references: [id], onUpdate: Restrict, map: "fk_creator_petcategory")
  user_petSpecies_updater_idTouser user     @relation("petSpecies_updater_idTouser", fields: [updater_id], references: [id], onUpdate: Restrict, map: "pk_updater_petcategory")
}

model pet_images {
  id                               Int      @id @default(autoincrement())
  pet_id                           Int
  path                             String   @db.VarChar(100)
  creation_date                    DateTime @db.Timestamp(6)
  creator_id                       Int
  update_date                      DateTime @db.Timestamp(6)
  updater_id                       Int
  user_pet_images_creator_idTouser user     @relation("pet_images_creator_idTouser", fields: [creator_id], references: [id], onUpdate: Restrict, map: "fk_creator_pet_images")
  pet                              pet      @relation(fields: [pet_id], references: [id], onUpdate: Restrict, map: "fk_pet_pet_images")
  user_pet_images_updater_idTouser user     @relation("pet_images_updater_idTouser", fields: [updater_id], references: [id], onUpdate: Restrict, map: "fk_updater_pet_images")
}

model role {
  id                 Int               @id(map: "pk_rol") @default(autoincrement())
  name               String            @db.VarChar(100)
  description        String?           @db.VarChar(100)
  active             Boolean?          @default(true)
  created_in         DateTime          @db.Timestamp(6)
  its_administrative Boolean           @default(false)
  permission_role    permission_role[]
  user               user[]
}

model user {
  id                                                       Int                   @id @default(autoincrement())
  first_name                                               String                @db.VarChar(100)
  last_name                                                String                @db.VarChar(100)
  email                                                    String                @unique(map: "user_username_key") @db.VarChar(100)
  password                                                 String                @db.VarChar(255)
  role_id                                                  Int
  registration_date                                        DateTime?             @default(now()) @db.Timestamp(6)
  it_is_verified                                           Boolean               @default(false)
  profile_public_id                                        String?               @unique(map: "user_unique")
  phone                                                    String?               @db.VarChar(25)
  profile_version                                          String?               @db.VarChar(100)
  adoptionApplication                                      adoptionApplication[]
  donation_donation_reviewed_byTouser                      donation[]            @relation("donation_reviewed_byTouser")
  donation_donation_user_idTouser                          donation[]            @relation("donation_user_idTouser")
  donationBankAccount_donationBankAccount_creator_idTouser donationBankAccount[] @relation("donationBankAccount_creator_idTouser")
  donationBankAccount_donationBankAccount_updater_idTouser donationBankAccount[] @relation("donationBankAccount_updater_idTouser")
  needSupplies_needSupplies_creator_idTouser               needSupplies[]        @relation("needSupplies_creator_idTouser")
  needSupplies_needSupplies_updater_idTouser               needSupplies[]        @relation("needSupplies_updater_idTouser")
  passwordResetToken                                       passwordResetToken[]
  pet_pet_creator_idTouser                                 pet[]                 @relation("pet_creator_idTouser")
  pet_pet_updater_idTouser                                 pet[]                 @relation("pet_updater_idTouser")
  petSpecies_petSpecies_creator_idTouser                   petSpecies[]          @relation("petSpecies_creator_idTouser")
  petSpecies_petSpecies_updater_idTouser                   petSpecies[]          @relation("petSpecies_updater_idTouser")
  pet_images_pet_images_creator_idTouser                   pet_images[]          @relation("pet_images_creator_idTouser")
  pet_images_pet_images_updater_idTouser                   pet_images[]          @relation("pet_images_updater_idTouser")
  project_project_creator_idTouser                         project[]             @relation("project_creator_idTouser")
  project_project_updater_idTouser                         project[]             @relation("project_updater_idTouser")
  project_photo_project_photo_creator_idTouser             project_photo[]       @relation("project_photo_creator_idTouser")
  project_photo_project_photo_updater_idTouser             project_photo[]       @relation("project_photo_updater_idTouser")
  savedPet                                                 savedPet[]
  sponsor_sponsor_creator_idTouser                         sponsor[]             @relation("sponsor_creator_idTouser")
  sponsor_sponsor_updater_idTouser                         sponsor[]             @relation("sponsor_updater_idTouser")
  role                                                     role                  @relation(fields: [role_id], references: [id], onUpdate: Restrict, map: "user_rol_fk")
}

model permission {
  id              Int               @id(map: "pk_permission") @default(autoincrement())
  name            String            @db.VarChar(100)
  description     String            @db.VarChar(200)
  module_id       Int
  action          action_permission
  created_in      DateTime          @db.Timestamp(6)
  module          module            @relation(fields: [module_id], references: [id], onUpdate: Restrict, map: "fk_module_permission")
  permission_role permission_role[]
}

model permission_role {
  id            Int        @id(map: "pk_permission_role") @default(autoincrement())
  role_id       Int
  permission_id Int
  created_in    DateTime   @db.Timestamp(6)
  permission    permission @relation(fields: [permission_id], references: [id], onUpdate: Restrict, map: "fk_permission_permission_role")
  role          role       @relation(fields: [role_id], references: [id], onUpdate: Restrict, map: "fk_role_permission_role")
}

model passwordResetToken {
  id         String   @id(map: "passwordresettoken_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token      String   @unique(map: "passwordresettoken_unique")
  user_id    Int
  expires_at DateTime @db.Timestamp(6)
  created_at DateTime @db.Timestamp(6)
  user       user     @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_user_passwordresettoken")
}

model formQuestion {
  id                String              @id(map: "pk_formQuestions") @default(dbgenerated("gen_random_uuid()"))
  section           String?             @db.VarChar(100)
  question_text     String
  field_type        String              @db.VarChar(100)
  options           Json?
  required          Boolean
  sort_order        Int
  active            Boolean
  applicationAnswer applicationAnswer[]
}

model adoptionApplication {
  id                      String                @id(map: "pk_adoptionApplications") @default(dbgenerated("gen_random_uuid()"))
  pet_id                  Int
  user_id                 Int
  status                  String                @db.VarChar(50)
  submitted_at            DateTime              @db.Timestamp(6)
  updated_at              DateTime              @db.Timestamp(6)
  rejection_reason        String?
  pet                     pet                   @relation(fields: [pet_id], references: [id], onUpdate: Restrict, map: "fk_pet_adoptionapplications")
  user                    user                  @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_user_adoptionapplications")
  other_applicationAnswer applicationAnswer[]   @relation("applicationAnswerToapplicationAnswer")
  commitmentAgreement     commitmentAgreement[]
}

model applicationAnswer {
  id                String              @id(map: "pk_applicationanswers") @default(dbgenerated("gen_random_uuid()"))
  application_id    String
  question_id       String
  answer_value      String
  applicationAnswer adoptionApplication @relation("applicationAnswerToapplicationAnswer", fields: [application_id], references: [id], onUpdate: Restrict, map: "applicationanswers_applicationanswers_fk")
  formQuestion      formQuestion        @relation(fields: [question_id], references: [id], onUpdate: Restrict, map: "applicationanswers_formquestions_fk")
}

model commitmentAgreement {
  id                  String              @id(map: "commitmentagreement_pk") @default(dbgenerated("gen_random_uuid()"))
  application_id      String
  agreement_text      String
  accepted            Boolean
  ip_address          String?             @db.VarChar
  signed_at           DateTime            @db.Timestamp(6)
  adoptionApplication adoptionApplication @relation(fields: [application_id], references: [id], onUpdate: Restrict, map: "commitmentagreement_adoptionapplication_fk")
}

model savedPet {
  id       String   @id(map: "savedpet_pk") @default(dbgenerated("gen_random_uuid()"))
  user_id  Int
  pet_id   Int
  saved_at DateTime @default(now()) @db.Timestamp(6)
  pet      pet      @relation(fields: [pet_id], references: [id], onUpdate: Restrict, map: "savedpet_pet_fk")
  user     user     @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "savedpet_user_fk")
}

model donation {
  id                              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                         Int?
  donor_name                      String?                @db.VarChar(100)
  donor_email                     String?                @db.VarChar(100)
  donor_phone                     String?                @db.VarChar(25)
  donation_type                   donation_type_donation
  declared_amount                 Decimal?               @db.Decimal(10, 2)
  item_description                String?
  bank_account_id                 Int?
  status                          String                 @db.VarChar(50)
  is_public                       Boolean                @default(false)
  is_anonymous                    Boolean                @default(false)
  submitted_at                    DateTime               @db.Timestamp(6)
  updated_at                      DateTime               @db.Timestamp(6)
  rejection_reason                String?
  reviewed_by                     Int?
  comment                         String?
  reference_number                String?                @db.VarChar(50)
  confirmed_amount                Decimal?               @db.Decimal(10, 2)
  patrocinador_id                 Int?
  proyecto_id                     Int?
  receipt_url                     String?                @db.VarChar(255)
  donationBankAccount             donationBankAccount?   @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bankaccount_donation")
  patrocinador                    sponsor?               @relation(fields: [patrocinador_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_patrocinador_donation")
  proyecto                        project?               @relation(fields: [proyecto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_proyecto_donation")
  user_donation_reviewed_byTouser user?                  @relation("donation_reviewed_byTouser", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reviewer_donation")
  user_donation_user_idTouser     user?                  @relation("donation_user_idTouser", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_donation")
}

model donationBankAccount {
  id                                        Int                              @id @default(autoincrement())
  bank_name                                 String                           @db.VarChar(100)
  account_type                              account_type_donationBankAccount
  account_number                            String                           @db.VarChar(50)
  account_holder                            String?                          @db.VarChar(100)
  active                                    Boolean                          @default(true)
  creation_date                             DateTime                         @default(now()) @db.Timestamp(6)
  creator_id                                Int
  update_date                               DateTime                         @default(now()) @db.Timestamp(6)
  updater_id                                Int
  donation                                  donation[]
  user_donationBankAccount_creator_idTouser user                             @relation("donationBankAccount_creator_idTouser", fields: [creator_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_creator_donationBankAccount")
  user_donationBankAccount_updater_idTouser user                             @relation("donationBankAccount_updater_idTouser", fields: [updater_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_updater_donationBankAccount")
}

model needSupplies {
  id                                 Int      @id(map: "insumoNecesitado_pkey") @default(autoincrement())
  description                        String   @db.VarChar(150)
  active                             Boolean  @default(true)
  creation_date                      DateTime @default(now()) @db.Timestamp(6)
  creator_id                         Int
  update_date                        DateTime @default(now()) @db.Timestamp(6)
  updater_id                         Int
  user_needSupplies_creator_idTouser user     @relation("needSupplies_creator_idTouser", fields: [creator_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_creator_insumoNecesitado")
  user_needSupplies_updater_idTouser user     @relation("needSupplies_updater_idTouser", fields: [updater_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_updater_insumoNecesitado")
}

model project {
  id                            Int             @id(map: "proyecto_pkey") @default(autoincrement())
  name                          String          @db.VarChar(150)
  description                   String
  goal                          String?         @db.VarChar(150)
  status                        status_proyecto @default(Activo)
  creation_date                 DateTime        @default(now()) @db.Timestamp(6)
  creator_id                    Int
  update_date                   DateTime        @default(now()) @db.Timestamp(6)
  updater_id                    Int
  progress                      Int?
  donation                      donation[]
  user_project_creator_idTouser user            @relation("project_creator_idTouser", fields: [creator_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_creator_proyecto")
  user_project_updater_idTouser user            @relation("project_updater_idTouser", fields: [updater_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_updater_proyecto")
  project_photo                 project_photo[]
}

model project_photo {
  id                                  Int                   @id(map: "proyectoFoto_pkey") @default(autoincrement())
  proyecto_id                         Int
  url                                 String                @db.VarChar(255)
  category                            category_proyectoFoto
  creation_date                       DateTime              @default(now()) @db.Timestamp(6)
  creator_id                          Int
  update_date                         DateTime              @default(now()) @db.Timestamp(6)
  updater_id                          Int
  user_project_photo_creator_idTouser user                  @relation("project_photo_creator_idTouser", fields: [creator_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_creator_proyectoFoto")
  project                             project               @relation(fields: [proyecto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_proyecto_proyectoFoto")
  user_project_photo_updater_idTouser user                  @relation("project_photo_updater_idTouser", fields: [updater_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_updater_proyectoFoto")
}

model sponsor {
  id                            Int        @id(map: "patrocinador_pkey") @default(autoincrement())
  name                          String     @db.VarChar(100)
  logo_url                      String?    @db.VarChar(255)
  website                       String?    @db.VarChar(150)
  contact                       String?    @db.VarChar(150)
  active                        Boolean    @default(true)
  creation_date                 DateTime   @default(now()) @db.Timestamp(6)
  creator_id                    Int
  update_date                   DateTime   @default(now()) @db.Timestamp(6)
  updater_id                    Int
  donation                      donation[]
  user_sponsor_creator_idTouser user       @relation("sponsor_creator_idTouser", fields: [creator_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_creator_patrocinador")
  user_sponsor_updater_idTouser user       @relation("sponsor_updater_idTouser", fields: [updater_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_updater_patrocinador")
}

// Respaldo en servidor de las sesiones de Remix (createSessionStorage): la
// cookie del cliente solo lleva este id firmado, no los datos. Sustituye a
// createCookieSessionStorage, cuyo payload (módulos + permisos) ya superaba
// el límite de ~4096 bytes de los navegadores.
model session {
  id         String   @id(map: "pk_session") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  data       Json
  expires_at DateTime @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamp(6)

  @@index([expires_at])
}

// Contador de ventana fija para limitar la tasa de intentos en rutas
// sensibles (login, recuperar clave, crear cuenta, notificar donación).
// `key` identifica la ventana (p. ej. "login:ip:1.2.3.4" o
// "login:email:foo@bar.com"); el incremento se hace con un UPSERT atómico
// (INSERT ... ON CONFLICT) desde rateLimit.service.ts, no con
// read-modify-write en la app, para no crear una condición de carrera justo
// en el mecanismo pensado para soportar ráfagas de requests.
model rateLimitBucket {
  key          String   @id @db.VarChar(150)
  window_start DateTime @db.Timestamp(6)
  count        Int      @default(1)
}

enum nav_audience_module {
  ALL
  AUTH_ONLY
  ADMIN_ONLY
}

enum nav_zone_module {
  TOPBAR
  ACCOUNT
  ADMIN_SIDEBAR
}

enum gender_pet {
  Macho
  Hembra
}

enum action_permission {
  Leer
  Crear
  Actualizar
  Eliminar
  Guardar
}

enum account_type_donationBankAccount {
  Monetaria
  Ahorro
  Pr_stamo           @map("Préstamo")
  Tarjeta_de_cr_dito @map("Tarjeta de crédito")
}

enum donation_type_donation {
  Monetaria
  Especie
}

enum status_proyecto {
  Activo
  Finalizado
}

enum category_proyectoFoto {
  Antes
  Durante
  Despu_s @map("Después")
}

enum status_pet {
  Disponible
  En_tratamiento
  Incapacitado
  Fallecido
  Retirado
  Adoptado
}
