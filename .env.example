# Copia este archivo a .env y completa los valores. No subas .env al repositorio.

# Base de datos PostgreSQL
# DATABASE_URL: conexión de la aplicación (pooler en modo transacción si usas Supabase)
# DIRECT_URL: conexión directa, usada por Prisma para aplicar el esquema (db push)
DATABASE_URL=
DIRECT_URL=

# Seguridad (usa valores largos y aleatorios, distintos en cada entorno)
SESSION_SECRET=
SALT_BCRYPT=
CRON_SECRET=

# Correo (Resend)
RESEND_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Imágenes (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL pública del sitio, sin "/" final (en desarrollo: http://localhost:3000)
SITE_URL=
